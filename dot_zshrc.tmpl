# Optional startup profiling: ZSH_PROFILE_STARTUP=1 zsh -i -c exit
if [[ -n "${ZSH_PROFILE_STARTUP:-}" ]]; then
  zmodload zsh/zprof
fi
# Paths and XDG vars (must be before zinit which uses XDG_*)
[[ -f ~/.zsh/path.zsh ]] && source ~/.zsh/path.zsh || echo "Warning: ~/.zsh/path.zsh not found"
# Zinit - load with error handling
[[ -f ~/.zsh/zinit.zsh ]] && source ~/.zsh/zinit.zsh || echo "Warning: ~/.zsh/zinit.zsh not found"
[[ -f ~/.zsh/alias.zsh ]] && source ~/.zsh/alias.zsh || echo "Warning: ~/.zsh/alias.zsh not found"

{{- if eq .chezmoi.os "linux" }}

# only source arch if the system is arch linux
if [[ -f /etc/arch-release && -f ~/.zsh/arch.zsh ]]; then
  source ~/.zsh/arch.zsh || echo "Warning: ~/.zsh/arch.zsh failed to load"
fi
{{- end }}

# History
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list '' \
  'm:{a-z}={A-Z}' \
  'r:|[._-]=** r:|=**'
zstyle ':completion:*' menu select
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always -- "$realpath"'
# zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'

# bind zsh zsh-autosuggestions accept to same as my neovim copilot
bindkey '^f' autosuggest-accept

# carapace - shell completion tool
# export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
# zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
# source <(carapace _carapace)

{{- if eq .chezmoi.os "darwin" }}

# mac too many files error fix
ulimit -n 65536
{{- end }}

if [[ -n "${ZSH_PROFILE_STARTUP:-}" ]]; then
  zprof
fi

# >>> chezmoi managed toolchain >>>
# CLI installers (grok, Antigravity, opencode) append PATH exports here.
# Keep every installer-added line inside these markers so `chezmoi diff` stays
# empty and the next apply cannot delete a working PATH entry.
# Credentials stay out of this file. See the jio-ado source line below.
[ -f "$HOME/.config/jio-ado/env" ] && source "$HOME/.config/jio-ado/env"

# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
# compinit is intentionally not called here. ~/.zsh/zinit.zsh owns it and
# writes the dump to $XDG_CACHE_HOME/zsh. A second `compinit -C` here wrote a
# duplicate dump to ~/.zcompdump and cost another 18ms per shell start.
# <<< grok installer <<<

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
# <<< chezmoi managed toolchain <<<

# PATH hygiene, last, after every startup file and plugin has added its own.
# ~/.zsh/path.zsh declares `typeset -U path`, which makes a duplicate
# unrepresentable for anything added after that point. Two gaps remain and this
# line closes both: zsh does not re-tie an array that was already populated from
# an inherited PATH, and it does not enforce uniqueness on a scalar `PATH=`
# assignment. Re-tying keeps the first occurrence of each value, so prepended
# tool directories keep their priority.
typeset -U path
path=(${path})
