[credential]
	helper = store
[http]
	sslVerify = false
[user]
	name = Sandeep Kumar
	email = sandepten@gmail.com
[init]
	defaultBranch = main
[core]
  compression = 9
  whitespace = error
  preloadindex = true
  pager = delta
	longpaths = true
	editor = nvim
[alias] # Omarchy - useful shortcuts
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[push]
  autoSetupRemote = true
  default = current
[diff] # Omarchy - clearer diffs
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[commit] # Omarchy
	verbose = true
[column] # Omarchy
	ui = auto
[branch] # Omarchy
	sort = -committerdate
[tag] # Omarchy
	sort = -version:refname
[rebase]
  autoStash = true
  missingCommitsCheck = warn
[rerere]
	enabled = true
	autoupdate = true # Omarchy
[delta]
  line-numbers = true
