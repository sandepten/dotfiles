#!/usr/bin/env bash
# Omarchy theme-set hook: sync Heroic Games Launcher with Omarchy colors.
# Runs after every `omarchy theme set`. Idempotent. Safe to run manually.
# Reads: ~/.local/state/omarchy/current/theme/colors.toml
# Writes: ~/.config/heroic/omarchy-theme/omarchy.css (Heroic custom theme)
# Updates: ~/.config/heroic/config.json (customThemesPath)
#          ~/.config/heroic/store/config.json (theme selection)
set -euo pipefail

COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
THEME_DIR="$HOME/.config/heroic/omarchy-theme"
CSS_FILE="$THEME_DIR/omarchy.css"

[ -f "$COLORS_FILE" ] || exit 0
mkdir -p "$THEME_DIR"

python3 - "$COLORS_FILE" "$CSS_FILE" <<'PYEOF'
import re, sys

colors_path, out_path = sys.argv[1:3]

vals = {}
with open(colors_path) as f:
    for line in f:
        m = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]+)"', line)
        if m:
            vals[m.group(1)] = m.group(2)

def g(key, fallback="#ffffff"):
    return vals.get(key, fallback)

background = g("background")
dark_bg = g("dark_background", background)
darker_bg = g("darker_background", dark_bg)
lighter_bg = g("lighter_background", background)
foreground = g("foreground")
bright_fg = g("bright_foreground", foreground)
light_fg = g("light_foreground", foreground)
dark_fg = g("dark_foreground", foreground)
accent = g("accent", foreground)
muted = g("muted", dark_fg)
selection = g("selection", lighter_bg)
red = g("red", accent)
green = g("green", accent)
blue = g("blue", accent)
yellow = g("yellow", accent)
cyan = g("cyan", accent)
magenta = g("magenta", accent)

css = f"""/* Generated by omarchy heroic-sync from {colors_path}. Do not edit. */
/* Omarchy theme for Heroic. Select "omarchy.css" under */
/* Heroic > Settings > Accessibility > Select Theme. */

body.omarchy {{
  --accent: {accent};
  --accent-overlay: {accent};
  --navbar-accent: {accent};

  --background: {background};
  --body-background: {dark_bg};
  --background-darker: {darker_bg};
  --background-lighter: {lighter_bg};
  --current-background: {dark_bg};
  --navbar-background: {dark_bg};
  --navbar-active-background: {selection};
  --navbar-active: {foreground};
  --navbar-inactive: {dark_fg};
  --gradient-body-background: {background};

  --input-background: {lighter_bg};
  --modal-background: {dark_bg};
  --modal-border: {muted};
  --modal-backdrop: {darker_bg};

  --success: {green};
  --success-hover: {green};
  --primary: {accent};
  --primary-hover: {blue};
  --danger: {red};
  --danger-hover: {red};

  --text-default: {foreground};
  --text-secondary: {light_fg};
  --text-title: {bright_fg};
  --text-hover: {accent};
  --text-tertiary: {dark_fg};
  --text-quartenary: {muted};
  --text-gametitle: {foreground};
  --text-log: {yellow};
  --text-warning: {yellow};
  --text-danger: {red};
  --link-highlight: {accent};

  --icons-background: {dark_bg};
  --action-icon: {foreground};
  --action-icon-hover: {accent};
  --action-icon-active: {accent};
  --icon-disabled: {muted};

  --divider: {muted};

  --secondary-button: {accent};
  --success-button: {green};
  --play-button: {accent};
  --install-button: {accent};
  --download-button: {blue};
  --download-button-overlay: {accent};
  --cancel-button: {yellow};
  --cancel-button-overlay: {yellow};

  --osk-background: {dark_bg};
  --osk-button-background: {lighter_bg};
  --osk-button-border: {muted};
  --controller-hints-background: transparent;

  --search-bar-background: {dark_bg};
  --search-bar-border: {muted};

  --anticheat-denied: {red};
  --anticheat-broken: {red};
  --anticheat-running: {cyan};
  --anticheat-supported: {green};
  --anticheat-planned: {magenta};
}}
"""

with open(out_path, "w") as f:
    f.write(css)

print(f"wrote {out_path} accent={accent} bg={background} fg={foreground}")
PYEOF

# Point Heroic at the omarchy custom-themes folder and select the theme.
# Both JSON edits are merges: all other Heroic settings are preserved.
python3 - "$THEME_DIR" <<'PYEOF'
import json, os, sys

theme_dir = sys.argv[1]

global_config = os.path.expanduser("~/.config/heroic/config.json")
if os.path.exists(global_config):
    try:
        with open(global_config) as f:
            data = json.load(f)
    except json.JSONDecodeError:
        sys.exit(0)
    ds = data.get("defaultSettings")
    if isinstance(ds, dict):
        if ds.get("customThemesPath") != theme_dir:
            ds["customThemesPath"] = theme_dir
            with open(global_config, "w") as f:
                json.dump(data, f, indent=2)
                f.write("\n")
            print(f"set customThemesPath={theme_dir} in {global_config}")

store_config = os.path.expanduser("~/.config/heroic/store/config.json")
if os.path.exists(store_config):
    try:
        with open(store_config) as f:
            data = json.load(f)
    except json.JSONDecodeError:
        sys.exit(0)
    if data.get("theme") != "omarchy.css":
        data["theme"] = "omarchy.css"
        with open(store_config, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        print(f"set theme=omarchy.css in {store_config}")
PYEOF

# Heroic reads the theme CSS at startup. If it is running, the new palette
# applies on next launch / theme re-select.
if pgrep -x heroic >/dev/null 2>&1; then
  echo "heroic-sync: Heroic is running, restart it to apply the new theme" >&2
fi
