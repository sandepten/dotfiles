#!/usr/bin/env bash
# Omarchy theme-set hook: sync Zen Browser chrome with Omarchy colors.
# Runs after every `omarchy theme set`. Idempotent. Safe to run manually.
# Reads: ~/.local/state/omarchy/current/theme/colors.toml
# Writes: ~/.cache/omarchy/zen-browser/zen-userChrome.css (+Content)
# Patches per-profile: chrome/userChrome.css, chrome/userContent.css, user.js
set -euo pipefail

COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/zen-browser"
CSS_CHROME="$CACHE_DIR/zen-userChrome.css"
CSS_CONTENT="$CACHE_DIR/zen-userContent.css"

[ -f "$COLORS_FILE" ] || exit 0
mkdir -p "$CACHE_DIR"

python3 - "$COLORS_FILE" "$CSS_CHROME" "$CSS_CONTENT" <<'PYEOF'
import re, sys

colors_path, chrome_out, content_out = sys.argv[1:4]

vals = {}
with open(colors_path) as f:
    for line in f:
        m = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]+)"', line)
        if m:
            vals[m.group(1)] = m.group(2)

def g(k, fallback="#ffffff"):
    return vals.get(k, fallback)

background = g("background")
lighter_bg = g("lighter_background", background)
foreground = g("foreground")
dark_fg = g("dark_foreground", foreground)
accent = g("accent", foreground)
muted = g("muted", dark_fg)
selection = g("selection", lighter_bg)
red = g("red", accent)
blue = g("blue", accent)
cyan = g("cyan", accent)
magenta = g("magenta", accent)

header = f"/* Generated by omarchy zen-theme-sync from {colors_path}. Do not edit. */\n"

variables = f""":root {{
  --base: {background} !important;
  --surface: {lighter_bg} !important;
  --overlay: {lighter_bg} !important;
  --hl_low: {selection} !important;
  --hl_med: {muted} !important;
  --hl_high: {accent} !important;
  --outline: {muted} !important;
  --muted: {muted} !important;
  --subtle: {dark_fg} !important;
  --text: {foreground} !important;
  --primary: {accent} !important;
  --secondary: {cyan} !important;
  --tertiary: {magenta} !important;
  --error: {red} !important;
}}
"""

chrome_body = """:root {
  --zen-primary-color: var(--primary) !important;
  --zen-colors-primary: var(--base) !important;
  --zen-colors-secondary: var(--surface) !important;
  --zen-colors-tertiary: var(--base) !important;
  --zen-colors-border: var(--outline) !important;
  --toolbar-bgcolor: var(--base) !important;
  --zen-themed-toolbar-bg: var(--base) !important;
  --zen-main-browser-background: var(--base) !important;
  --toolbox-bgcolor-inactive: var(--base) !important;
  --zen-urlbar-background: var(--surface) !important;
  --zen-colors-input-bg: var(--surface) !important;
  --zen-themed-toolbar-bg-transparent: transparent !important;
  --lwt-text-color: var(--text) !important;
  --toolbarbutton-icon-fill: var(--primary) !important;
  --toolbar-field-color: var(--text) !important;
  --toolbar-field-focus-color: var(--text) !important;
  --toolbar-color: var(--text) !important;
  --toolbox-textcolor: var(--text) !important;
  --toolbox-textcolor-inactive: var(--text) !important;
  --tab-selected-textcolor: var(--primary) !important;
  --newtab-text-primary-color: var(--text) !important;
  --arrowpanel-color: var(--text) !important;
  --arrowpanel-background: var(--overlay) !important;
  --sidebar-text-color: var(--text) !important;
  --lwt-sidebar-text-color: var(--text) !important;
  --lwt-sidebar-background-color: var(--base) !important;
}
#zen-browser-background {
  --zen-main-browser-background: var(--base) !important;
}
#navigator-toolbox, #zen-tabbox-wrapper, .sidebar-panel {
  background-color: var(--base) !important;
}
#zen-sidebar-splitter {
  background-color: var(--base) !important;
  opacity: 1 !important;
}
.sidebar-placesTree {
  background-color: var(--surface) !important;
}
#zen-workspaces-button {
  background-color: var(--surface) !important;
}
#zen-appcontent-navbar-container {
  background-color: var(--base) !important;
}
#back-button .toolbarbutton-icon, #forward-button .toolbarbutton-icon,
#reload-button .toolbarbutton-icon, #stop-button .toolbarbutton-icon,
#PanelUI-menu-button .toolbarbutton-icon, #unified-extensions-button .toolbarbutton-icon,
#nav-bar-overflow-button .toolbarbutton-icon {
  fill: var(--primary) !important;
  color: var(--primary) !important;
}
#back-button[disabled] .toolbarbutton-icon, #forward-button[disabled] .toolbarbutton-icon {
  opacity: 0.3 !important;
}
.tab-text { color: var(--text); }
toolbarbutton#tabs-newtab-button { color: var(--text) !important; }
#urlbar-input::selection {
  background-color: var(--primary) !important;
  color: var(--base) !important;
}
.urlbar-background { background-color: var(--surface) !important; }
.urlbarView-url { color: var(--primary) !important; }
#urlbar-results { background-color: var(--surface) !important; color: var(--text) !important; }
.urlbarView-row:not([selected]) :is(.urlbarView-title, .urlbarView-action) { color: var(--text) !important; }
.tab-background[selected=""] { background: var(--hl_low) !important; }
.tabbrowser-tab:hover > .tab-stack > .tab-background { background-color: var(--hl_med) !important; }
#TabsToolbar, hbox#titlebar { background-color: var(--base) !important; }
dialog { background: var(--base) !important; color: var(--text) !important; }
::selection { background-color: var(--primary) !important; color: var(--base) !important; }
menu:where([_moz-menuactive="true"]:not([disabled="true"])),
menuitem:where([_moz-menuactive="true"]:not([disabled="true"])) {
  background-color: var(--primary) !important;
  color: var(--base) !important;
}
*|input[type="checkbox"], [type="checkbox"],
*|input[type="radio"], [type="radio"] { accent-color: var(--primary) !important; }
#ContentSelectDropdown, #ContentSelectDropdown > menupopup {
  --arrowpanel-background: var(--overlay) !important;
  --arrowpanel-color: var(--text) !important;
  background-color: var(--overlay) !important;
  color: var(--text) !important;
}
"""

content_body = """@-moz-document url-prefix("about:") {
  :root {
    --in-content-page-color: var(--secondary) !important;
    --color-accent-primary: var(--primary) !important;
    background-color: var(--surface) !important;
    --in-content-page-background: var(--overlay) !important;
  }
  .main-heading, .main-search, #content, .sticky-container, #search-container {
    background-color: var(--base) !important;
  }
}
@-moz-document url("about:newtab"), url("about:home") {
  :root {
    --newtab-background-color: var(--overlay) !important;
    --newtab-background-color-secondary: var(--surface) !important;
    --newtab-element-hover-color: var(--hl_low) !important;
    --newtab-text-primary-color: var(--text) !important;
    --newtab-wordmark-color: var(--text) !important;
    --newtab-primary-action-background: var(--primary) !important;
  }
}
@-moz-document url-prefix("about:preferences") {
  :root {
    --zen-colors-tertiary: var(--surface) !important;
    --in-content-text-color: var(--text) !important;
    --link-color: var(--secondary) !important;
    --zen-primary-color: var(--primary) !important;
    --in-content-page-background: var(--base) !important;
  }
  moz-card, .main-content { background-color: var(--base) !important; }
}
@-moz-document url-prefix("about:addons") {
  :root {
    --zen-dark-color-mix-base: var(--surface) !important;
    --background-color-box: var(--overlay) !important;
  }
}
::selection { background-color: var(--primary) !important; color: var(--base) !important; }
"""

with open(chrome_out, "w") as f:
    f.write(header + variables + chrome_body)
with open(content_out, "w") as f:
    f.write(header + variables + content_body)

print(f"wrote {chrome_out} and {content_out} accent={accent} bg={background} fg={foreground}")
PYEOF

LINE_CHROME="@import \"$CSS_CHROME\";"
LINE_CONTENT="@import \"$CSS_CONTENT\";"

ACCENT=$(grep -E '^accent\s*=' "$COLORS_FILE" | head -1 | sed -E 's/.*"(.*)".*/\1/')
[ -n "${ACCENT:-}" ] || ACCENT="#607db2"

write_if_changed() {
  local target="$1" tmp="$2"
  if [ -f "$target" ] && cmp -s "$target" "$tmp"; then
    rm -f "$tmp"
  else
    cat "$tmp" >"$target"
  fi
  rm -f "$tmp"
}

ZEN_DIRS=()
for d in "${XDG_CONFIG_HOME:-$HOME/.config}/zen" "$HOME/.zen"; do
  [ -d "$d" ] && ZEN_DIRS+=("$d")
done
[ "${#ZEN_DIRS[@]}" -eq 0 ] && exit 0

find "${ZEN_DIRS[@]}" -mindepth 2 -maxdepth 2 -type f -name "prefs.js" -print0 |
  while IFS= read -r -d '' prefs_file; do
    profile_dir=$(dirname "$prefs_file")
    chrome_dir="$profile_dir/chrome"
    user_chrome="$chrome_dir/userChrome.css"
    user_content="$chrome_dir/userContent.css"
    user_js="$profile_dir/user.js"

    mkdir -p "$chrome_dir"
    touch "$user_chrome" "$user_content" "$user_js"

    tmp_chrome=$(mktemp "${user_chrome}.tmp.XXXXXX")
    printf '%s\n' "$LINE_CHROME" >"$tmp_chrome"
    sed '/omarchy\/zen-browser\/zen-userChrome\.css/d' "$user_chrome" >>"$tmp_chrome"
    write_if_changed "$user_chrome" "$tmp_chrome"

    tmp_content=$(mktemp "${user_content}.tmp.XXXXXX")
    printf '%s\n' "$LINE_CONTENT" >"$tmp_content"
    sed '/omarchy\/zen-browser\/zen-userContent\.css/d' "$user_content" >>"$tmp_content"
    write_if_changed "$user_content" "$tmp_content"

    tmp_js=$(mktemp "${user_js}.tmp.XXXXXX")
    sed -e '/toolkit\.legacyUserProfileCustomizations\.stylesheets/d' \
        -e '/devtools\.chrome\.enabled/d' \
        -e '/zen\.theme\.accent-color/d' \
        "$user_js" >"$tmp_js"
    [ -s "$tmp_js" ] && [ -n "$(tail -c1 "$tmp_js")" ] && echo >>"$tmp_js"
    printf '%s\n' \
      'user_pref("devtools.chrome.enabled", true);' \
      'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' \
      "user_pref(\"zen.theme.accent-color\", \"$ACCENT\");" >>"$tmp_js"
    write_if_changed "$user_js" "$tmp_js"

    echo "zen-theme-sync: updated $profile_dir"
  done
