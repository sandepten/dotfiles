{{- /*
Paths here are destination-relative, so .config/hypr and not dot_config/hypr.
A source-relative path is silently ignored, which is why arch.zsh stayed
managed on macOS for as long as the old file existed.

This file is a Go template, so the OS conditionals below are honoured.
*/ -}}
{{- if ne .chezmoi.os "linux" }}
.zsh/arch.zsh
.config/hypr
{{- /* Wayland desktop, the omarchy state tree, and the terminals that import
     a theme out of ~/.local/state/omarchy. On macOS those imports point at a
     path that does not exist, and alacritty refuses to start. */}}
.config/omarchy
.config/foot
.config/alacritty
.config/herdr
.config/imv
.config/voxtype
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
{{- /* kitty.conf includes the omarchy theme file with no optionality. */}}
.config/kitty
{{- end }}
{{- /* Generated by the omarchy theme-set hook; see omarchy/themed/starship.toml.tpl */}}
.config/starship.toml
.zsh_history
.zcompdump
.DS_Store
