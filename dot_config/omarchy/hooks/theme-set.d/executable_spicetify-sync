#!/usr/bin/env bash
# Omarchy theme-set hook: sync Spicetify with Omarchy colors.
# Runs after every `omarchy theme set`. Idempotent. Safe to run manually.
# Reads: ~/.local/state/omarchy/current/theme/colors.toml
# Writes: ~/.config/spicetify/Themes/omarchy/color.ini
# Sets spicetify theme to omarchy and applies.
set -euo pipefail

COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
THEME_DIR="$HOME/.config/spicetify/Themes/omarchy"
COLOR_FILE="$THEME_DIR/color.ini"
USER_CSS="$THEME_DIR/user.css"

[ -f "$COLORS_FILE" ] || exit 0
mkdir -p "$THEME_DIR"

python3 - "$COLORS_FILE" "$COLOR_FILE" <<'PYEOF'
import re, sys

colors_path, out_path = sys.argv[1:3]

vals = {}
with open(colors_path) as f:
    for line in f:
        m = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]+)"', line)
        if m:
            vals[m.group(1)] = m.group(2)

def hexval(key, fallback="#ffffff"):
    v = vals.get(key, fallback)
    v = v.strip().lstrip("#")
    if len(v) == 3:
        v = "".join(c * 2 for c in v)
    return v.upper()

text = hexval("foreground")
subtext = hexval("light_foreground", vals.get("dark_foreground", "#ffffff"))
subtext = subtext.lstrip("#").upper()
main = hexval("background")
sidebar = hexval("dark_background", vals.get("background", "#000000"))
player = hexval("background")
card = hexval("lighter_background", vals.get("background", "#000000"))
shadow = hexval("darker_background", vals.get("background", "#000000"))
selected_row = hexval("bright_foreground", vals.get("foreground", "#ffffff"))
button = hexval("accent", vals.get("blue", "#ffffff"))
button_active = hexval("selection", vals.get("accent", "#ffffff"))
button_disabled = hexval("muted", vals.get("selection", "#ffffff"))
tab_active = hexval("selection", vals.get("accent", "#ffffff"))
notification = hexval("accent", vals.get("blue", "#ffffff"))
notification_error = hexval("red", "#e22134")
misc = hexval("dark_foreground", vals.get("muted", "#ffffff"))

content = f"""; Generated by omarchy spicetify-sync from {colors_path}. Do not edit.
; Omarchy palette follows `omarchy theme set`.

[omarchy]
text               = {text}
subtext            = {subtext}
main               = {main}
sidebar            = {sidebar}
player             = {player}
card               = {card}
shadow             = {shadow}
selected-row       = {selected_row}
button             = {button}
button-active      = {button_active}
button-disabled    = {button_disabled}
tab-active         = {tab_active}
notification       = {notification}
notification-error = {notification_error}
misc               = {misc}
"""

with open(out_path, "w") as f:
    f.write(content)

print(f"wrote {out_path} button={button} bg={main} fg={text}")
PYEOF

# Spicetify needs an empty user.css to exist for the theme folder to be valid.
[ -f "$USER_CSS" ] || : >"$USER_CSS"

# Point spicetify at the omarchy theme. Preserves extensions and custom_apps.
spicetify config current_theme omarchy color_scheme omarchy >/dev/null

# Spicetify writes into /opt/spotify. After a Spotify update that dir resets
# to root ownership and apply fails with permission denied.
if [ ! -w /opt/spotify/Apps ]; then
  # Try a passwordless fix for unattended theme switches, ignore failure.
  sudo -n chown -R "$(whoami)":"$(whoami)" /opt/spotify 2>/dev/null || true
fi

if [ ! -w /opt/spotify/Apps ]; then
  echo "spicetify-sync: /opt/spotify not writable, run: sudo chown -R $(whoami):$(whoami) /opt/spotify && spicetify apply" >&2
  exit 0
fi

# Apply theme. Fall back to backup apply on first run with no backup yet.
if ! spicetify apply; then
  spicetify backup apply
fi
